msgid ""
"SHA-256 mismatch: received %(got)s, expected %(exp)s. The file was corrupted"
" in transit."
msgstr ""
"El SHA-256 no coincide: se recibió %(got)s, se esperaba %(exp)s. El archivo "
"se corrompió en el envío."

#. module: muk_mcp_attachment
#. odoo-python
#: code:addons/muk_mcp_attachment/mcp/attachment.py:0
msgid ""
"Size mismatch: received %(got)s bytes, expected %(exp)s. The file was "
"truncated or corrupted in transit."
msgstr ""
"El tamaño no coincide: se recibieron %(got)s bytes, se esperaban %(exp)s. El"
" archivo se truncó o se corrompió en el envío."

